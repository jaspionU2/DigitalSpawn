# Configurações de conexão com o banco de dados

# Nome do banco de dados a ser utilizado
DB_NAME='nome_do_banco'

# Usuário para autenticação no banco de dados
DB_USER='nome_do_usuario'

# Senha do usuário para autenticação no banco de dados
DB_PASSWORD='senha_do_banco'

# Endereço do servidor onde o banco de dados está hospedado
DB_HOST='host_do_banco'

# Porta de conexão com o banco de dados
DB_PORT='porta_do_banco'

# Driver/tipo do banco de dados (ex: mysql, postgresql, sqlite)
DB_DRIVER='banco_utilizado'

# URL completa de conexão gerada automaticamente a partir das variáveis acima
DB_URL="${DB_DRIVER}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# configurações do twig
APP_ENV='dev/prod'
TWIG_CACHE_PATH='caminho/para/cache'