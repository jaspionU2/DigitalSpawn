<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DigitalSpawn - Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#E81409',
                        secondary: '#D65B11',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-white min-h-screen flex">
    
    <!-- Login Box - Left Side -->
    <div class="w-full lg:w-1/2 bg-gradient-to-br from-primary to-secondary p-8 lg:p-16 flex flex-col justify-center">
        <div class="max-w-md mx-auto w-full">
            <!-- Logo -->
            <div class="mb-12">
                <div class="flex items-center space-x-2 mb-6">
                    <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center font-bold text-2xl text-primary">DS</div>
                    <span class="text-2xl font-bold text-black">Digital<span class="text-black">Spawn</span></span>
                </div>
                <h1 class="text-5xl font-bold text-orange-500 mb-3">WELCOME</h1>
                <p class="text-orange-400 font-bold text-opacity-0">Faça login para acessar sua conta</p>
            </div>

            <!-- Login Form -->
            <form 
                action="/auth/login" method="post" id="loginForm"  class="space-y-5">
                <!-- Username Input -->
                <div>
                    <input
                        id="email",
                        name="email"
                        type="text" 
                        placeholder="E-mail" 
                        class="w-full px-6 py-4 rounded-full bg-white text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-4 focus:ring-white focus:ring-opacity-30 transition shadow-lg"
                    >
                </div>

                <!-- Password Input -->
                <div>
                    <input
                        id="password",
                        name="password"
                        type="password" 
                        placeholder="••••••••" 
                        class="w-full px-6 py-4 rounded-full bg-white text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-4 focus:ring-white focus:ring-opacity-30 transition shadow-lg"
                    >
                </div>

                <!-- Submit Button -->
                <button 
                    type="submit" 
                    class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-4 rounded-full transition transform hover:scale-105 shadow-xl uppercase tracking-wider text-lg mt-6"
                >
                    Submit
                </button>

                <!-- Links -->
                <div class="flex justify-between items-center text-sm text-white pt-4">
                    <a href="#" class="text-black font-bold hover:underline transition">Esqueceu a senha?</a>
                    <a href="/auth/register" class="text-black font-bold hover:underline transition">Criar conta</a>
                </div>
            </form>

            <!-- Divider -->
            <div class="my-8">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-white border-opacity-30"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-primary text-white">ou continue com</span>
                    </div>
                </div>
            </div>

            <!-- Social Login -->
            <div class="grid grid-cols-3 gap-4">
                <button class="bg-white hover:bg-gray-100 p-4 rounded-xl transition transform hover:scale-105 shadow-lg">
                    <svg class="w-6 h-6 mx-auto text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                </button>
                <button class="bg-white hover:bg-gray-100 p-4 rounded-xl transition transform hover:scale-105 shadow-lg">
                    <svg class="w-6 h-6 mx-auto text-red-500" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z"/>
                    </svg>
                </button>
                <button class="bg-white hover:bg-gray-100 p-4 rounded-xl transition transform hover:scale-105 shadow-lg">
                    <svg class="w-6 h-6 mx-auto text-gray-800" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Illustration - Right Side -->
    <div class="hidden lg:flex w-1/2 bg-gray-50 items-center justify-center relative overflow-hidden">
        <!-- Decorative Circles -->
        <div class="absolute top-20 right-20 w-32 h-32 rounded-full" style="background: #E81409; opacity: 0.1;"></div>
        <div class="absolute bottom-32 left-20 w-48 h-48 rounded-full" style="background: #D65B11; opacity: 0.15;"></div>
        <div class="absolute top-1/2 right-32 w-24 h-24 rounded-full" style="background: #E81409; opacity: 0.08;"></div>

        <!-- Main Illustration Container -->
        <div class="relative z-10 max-w-lg">
            <!-- Phone Mockup -->
            <div class="relative mx-auto" style="width: 300px;">
                <!-- Phone Frame -->
                <div class="bg-white rounded-3xl shadow-2xl p-6 transform rotate-3 hover:rotate-0 transition-transform duration-500">
                    <div class="rounded-2xl p-8 shadow-inner" style="background: linear-gradient(135deg, #E81409 0%, #D65B11 100%);">
                        <!-- Avatar Circle -->
                        <div class="bg-white w-28 h-28 rounded-full mx-auto mb-6 flex items-center justify-center shadow-lg">
                            <svg class="w-14 h-14" style="color: #E81409;" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                        </div>
                        
                        <!-- Password Dots -->
                        <div class="bg-white rounded-full px-6 py-4 mb-6 shadow-md">
                            <div class="flex items-center justify-center space-x-2">
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                                <div class="w-2.5 h-2.5 bg-gray-800 rounded-full"></div>
                            </div>
                        </div>

                        <!-- Login Button -->
                        <button class="bg-green-500 text-white font-bold py-3 px-8 rounded-full w-full shadow-lg hover:bg-green-600 transition">
                            LOGIN
                        </button>
                    </div>
                </div>

                <!-- Floating Person Silhouette - Left -->
                <div class="absolute -left-24 top-16 w-24 h-40 rounded-t-full" style="background: linear-gradient(180deg, #E81409 0%, #D65B11 100%); opacity: 0.8;"></div>

                <!-- Floating Person Silhouette - Right Bottom -->
                <div class="absolute -right-16 bottom-8 w-32 h-32 rounded-full" style="background: linear-gradient(135deg, #D65B11 0%, #E81409 100%); opacity: 0.7;"></div>
            </div>

            <!-- Animated Paper Plane -->
            <div class="absolute top-16 right-10 animate-float">
                <svg class="w-16 h-16" style="color: #E81409;" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
            </div>

            <!-- Dotted Path -->
            <svg class="absolute top-20 right-16 w-48 h-48 opacity-40" viewBox="0 0 200 200">
                <path d="M 20 100 Q 60 40, 100 100 T 180 100" stroke="#E81409" stroke-width="3" fill="none" stroke-dasharray="8,8"/>
            </svg>

            <!-- Bottom Text -->
            <div class="text-center mt-12">
                <p class="text-gray-500 text-lg font-medium">Acesse milhares de jogos digitais</p>
            </div>
        </div>
    </div>

    <style>
        @keyframes float {
            0%, 100% {
                transform: translateY(0px) translateX(0px);
            }
            25% {
                transform: translateY(-15px) translateX(5px);
            }
            50% {
                transform: translateY(-5px) translateX(10px);
            }
            75% {
                transform: translateY(-20px) translateX(5px);
            }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }
    </style>
</body>
</html>