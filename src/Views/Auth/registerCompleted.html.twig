{% extends "./Templates/registerScreen.html.twig" %}

{% block title %}Confirmação de cadastro - DigitalSpawn{% endblock title %}

    {% block header %}
    <!-- Header -->
    <header class="bg-black border-b border-zinc-800">
        <nav class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <a href="index.html" class="text-2xl font-bold">
                    <span class="text-primary">Digital</span><span class="text-secondary">Spawn</span>
                </a>
            </div>
        </nav>
    </header>
    {% endblock header %}

    {% block content %}
    <!-- Validation Section -->
    <section class="py-12 min-h-screen flex items-center">
        <div class="container mx-auto px-6">
            <div class="max-w-2xl mx-auto">
                
                <!-- SUCCESS CONTENT -->
                <div id="success-content" class="hidden">
                    <!-- Card de Sucesso -->
                    <div class="bg-zinc-800 rounded-2xl border border-zinc-700 overflow-hidden">
                        <!-- Progress Steps -->
                        <div class="bg-black p-6 border-b border-zinc-700">
                            <div class="flex items-center justify-between max-w-md mx-auto">
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center font-bold text-black">
                                        ✓
                                    </div>
                                    <span class="text-xs mt-2 text-primary">Dados Pessoais</span>
                                </div>
                                <div class="flex-1 h-1 bg-primary mx-4"></div>
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center font-bold text-black">
                                        ✓
                                    </div>
                                    <span class="text-xs mt-2 text-primary">Segurança</span>
                                </div>
                                <div class="flex-1 h-1 bg-primary mx-4"></div>
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center font-bold text-black">
                                        ✓
                                    </div>
                                    <span class="text-xs mt-2 text-primary">Concluído</span>
                                </div>
                            </div>
                        </div>

                        <!-- Conteúdo -->
                        <div class="p-8 md:p-12 text-center">
                            <!-- Ícone de Sucesso -->
                            <div class="mb-8">
                                <div class="w-24 h-24 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center mx-auto">
                                    <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                            </div>

                            <!-- Título -->
                            <h1 class="text-3xl md:text-4xl font-bold mb-4">
                                E-mail Validado com <span class="text-primary">Sucesso!</span>
                            </h1>

                            <!-- Descrição -->
                            <p class="text-zinc-400 text-lg mb-8">
                                Parabéns! Seu cadastro foi concluído e seu e-mail foi verificado com sucesso. 
                                Sua conta está pronta para uso.
                            </p>

                            <!-- Benefícios Card -->
                            <div class="bg-zinc-900 rounded-xl p-6 mb-8 border border-zinc-700">
                                <div class="flex items-start space-x-4 mb-4">
                                    <div class="text-3xl">🎁</div>
                                    <div class="text-left">
                                        <h3 class="font-bold text-lg mb-2">Seu cupom de boas-vindas está ativo!</h3>
                                        <p class="text-zinc-400 text-sm">Use o código <span class="text-primary font-bold">BEMVINDO10</span> para ganhar 10% de desconto na primeira compra.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Contador de Redirecionamento -->
                            <div class="bg-black rounded-xl p-6 mb-8 border border-zinc-700">
                                <p class="text-zinc-300 mb-2">Você será redirecionado em</p>
                                <div class="text-5xl font-bold text-primary" id="countdown">5</div>
                                <p class="text-zinc-400 text-sm mt-2">segundos</p>
                            </div>

                            <!-- Botões -->
                            <div class="space-y-4">
                                <a href="index.html" class="block w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 text-white font-bold py-4 rounded-lg transition">
                                    Ir para a Página Inicial
                                </a>
                                <a href="perfil.html" class="block w-full bg-zinc-900 border border-zinc-700 hover:border-primary text-white font-semibold py-4 rounded-lg transition">
                                    Completar Meu Perfil
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Features -->
                    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="text-center p-4 bg-zinc-800 rounded-xl border border-zinc-700">
                            <div class="text-3xl mb-2">⚡</div>
                            <p class="text-sm text-zinc-300">Entrega instantânea</p>
                        </div>
                        <div class="text-center p-4 bg-zinc-800 rounded-xl border border-zinc-700">
                            <div class="text-3xl mb-2">🔒</div>
                            <p class="text-sm text-zinc-300">Compra 100% segura</p>
                        </div>
                        <div class="text-center p-4 bg-zinc-800 rounded-xl border border-zinc-700">
                            <div class="text-3xl mb-2">💎</div>
                            <p class="text-sm text-zinc-300">Ofertas exclusivas</p>
                        </div>
                    </div>
                </div>

                <!-- ERROR CONTENT -->
                <div id="error-content" class="hidden">
                    <!-- Card de Erro -->
                    <div class="bg-zinc-800 rounded-2xl border border-zinc-700 overflow-hidden">
                        <!-- Progress Steps -->
                        <div class="bg-black p-6 border-b border-zinc-700">
                            <div class="flex items-center justify-between max-w-md mx-auto">
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center font-bold text-black">
                                        ✓
                                    </div>
                                    <span class="text-xs mt-2 text-primary">Dados Pessoais</span>
                                </div>
                                <div class="flex-1 h-1 bg-primary mx-4"></div>
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center font-bold text-black">
                                        ✓
                                    </div>
                                    <span class="text-xs mt-2 text-primary">Segurança</span>
                                </div>
                                <div class="flex-1 h-1 bg-zinc-700 mx-4"></div>
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 bg-secondary rounded-full flex items-center justify-center font-bold text-white">
                                        ✕
                                    </div>
                                    <span class="text-xs mt-2 text-secondary">Erro</span>
                                </div>
                            </div>
                        </div>

                        <!-- Conteúdo -->
                        <div class="p-8 md:p-12 text-center">
                            <!-- Ícone de Erro -->
                            <div class="mb-8">
                                <div class="w-24 h-24 bg-gradient-to-br from-secondary to-red-600 rounded-full flex items-center justify-center mx-auto">
                                    <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </div>
                            </div>

                            <!-- Título -->
                            <h1 class="text-3xl md:text-4xl font-bold mb-4">
                                Erro na <span class="text-secondary">Validação</span>
                            </h1>

                            <!-- Descrição -->
                            <p class="text-zinc-400 text-lg mb-8">
                                Não conseguimos validar seu e-mail. O link pode ter expirado ou já foi utilizado anteriormente.
                            </p>

                            <!-- Motivos Possíveis -->
                            <div class="bg-zinc-900 rounded-xl p-6 mb-8 border border-zinc-700 text-left">
                                <h3 class="font-bold mb-4 flex items-center">
                                    <svg class="w-5 h-5 mr-2 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                    </svg>
                                    Possíveis causas:
                                </h3>
                                <ul class="space-y-3 text-zinc-400">
                                    <li class="flex items-start">
                                        <span class="text-secondary mr-2">•</span>
                                        <span>O link de validação expirou (válido por 24 horas)</span>
                                    </li>
                                    <li class="flex items-start">
                                        <span class="text-secondary mr-2">•</span>
                                        <span>O e-mail já foi validado anteriormente</span>
                                    </li>
                                    <li class="flex items-start">
                                        <span class="text-secondary mr-2">•</span>
                                        <span>Link inválido ou corrompido</span>
                                    </li>
                                    <li class="flex items-start">
                                        <span class="text-secondary mr-2">•</span>
                                        <span>Problemas temporários no servidor</span>
                                    </li>
                                </ul>
                            </div>

                            <!-- Botões -->
                            <div class="space-y-4">
                                <button class="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 text-white font-bold py-4 rounded-lg transition">
                                    Reenviar E-mail de Validação
                                </button>
                                <a href="cadastro.html" class="block w-full bg-zinc-900 border border-zinc-700 hover:border-primary text-white font-semibold py-4 rounded-lg transition">
                                    Tentar Novo Cadastro
                                </a>
                                <a href="index.html" class="block w-full text-zinc-400 hover:text-primary font-semibold py-3 transition">
                                    Voltar para a Página Inicial
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Suporte -->
                    <div class="mt-8 bg-zinc-800 rounded-xl p-6 border border-zinc-700 text-center">
                        <h3 class="font-bold mb-2">Precisa de ajuda?</h3>
                        <p class="text-zinc-400 text-sm mb-4">
                            Nossa equipe de suporte está disponível 24/7 para ajudá-lo
                        </p>
                        <div class="flex justify-center space-x-4">
                            <a href="#" class="text-primary hover:underline text-sm font-semibold">
                                Chat Online
                            </a>
                            <span class="text-zinc-600">•</span>
                            <a href="#" class="text-primary hover:underline text-sm font-semibold">
                                suporte@digitalspawn.com
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    {% endblock content %}

    {% block footer %}
    <!-- Footer -->
    <footer class="bg-black py-8 border-t border-zinc-800">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center justify-between">
                <div class="text-zinc-400 text-sm mb-4 md:mb-0">
                    &copy; 2026 DigitalSpawn. Todos os direitos reservados.
                </div>
                <div class="flex space-x-6 text-sm text-zinc-400">
                    <a href="#" class="hover:text-primary transition">Termos de Uso</a>
                    <a href="#" class="hover:text-primary transition">Privacidade</a>
                    <a href="#" class="hover:text-primary transition">Ajuda</a>
                </div>
            </div>
        </div>
    </footer>
    {% endblock footer %}

    {% block script %}
    <script>
        const validationSuccess = true;
        let countdown = 10;

        function updateCountdown() {
            const element = document.getElementById('countdown');
            if (element && validationSuccess) {
                element.textContent = countdown;
                if (countdown > 0) {
                    countdown--;
                    setTimeout(updateCountdown, 1000);
                } else {
                    window.location.href = '/';
                }
            }
        }

        window.onload = function() {
            const successDiv = document.getElementById('success-content');
            const errorDiv = document.getElementById('error-content');
            
            if (validationSuccess) {
                successDiv.classList.remove('hidden');
                errorDiv.classList.add('hidden');
                updateCountdown();
            } else {
                successDiv.classList.add('hidden');
                errorDiv.classList.remove('hidden');
            }
        }
    </script>
    {% endblock script %}