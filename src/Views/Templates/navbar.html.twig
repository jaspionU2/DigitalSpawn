<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DigitalSpawn - Chaves Digitais para Jogos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#E81409',
                        secondary: '#D65B11',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-zinc-900 text-white">
    <!-- Header -->
    <header class="bg-zinc-950 shadow-lg sticky top-0 z-50">
        <nav class="container mx-auto px-6 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center font-bold text-xl">DS</div>
                    <span class="text-2xl font-bold">Digital<span class="text-primary">Spawn</span></span>
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="#" class="hover:text-primary transition">Início</a>
                    <a href="#" class="hover:text-primary transition">Jogos</a>
                    <a href="#" class="hover:text-primary transition">Ofertas</a>
                    <a href="#" class="hover:text-primary transition">Suporte</a>
                </div>
                <div class="flex items-center space-x-4">
                    <button class="hover:text-primary transition">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                    <button class="hover:text-primary transition">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </button>
                    <button class="bg-primary hover:bg-red-700 px-6 py-2 rounded-lg font-semibold transition">
                        <a href="../login.html.twig" class="text-white no-underline">Login</a>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <!-- Hero Section -->
    {% block content %}
    {% endblock %}
</body>
</html>