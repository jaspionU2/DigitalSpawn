            <!-- Suggestions -->
            <div class="mt-16 pt-12 border-t border-zinc-800">
                <h3 class="text-xl font-bold mb-6 text-zinc-300">Talvez você esteja procurando:</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
                    <a href="index.html" class="bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 hover:border-primary rounded-lg p-4 transition group">
                        <svg class="w-8 h-8 text-primary mb-2 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        <p class="font-semibold group-hover:text-primary transition">Página Inicial</p>
                    </a>
                    <a href="jogos.html" class="bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 hover:border-primary rounded-lg p-4 transition group">
