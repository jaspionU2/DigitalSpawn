{% extends "./Templates/navbar.html.twig" %}

    {% block content %}
    <section class="relative bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900 py-20 overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-20 left-20 w-72 h-72 bg-primary rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 right-20 w-96 h-96 bg-secondary rounded-full blur-3xl"></div>
        </div>
        <div class="container mx-auto px-6 relative z-10">
            <div class="text-center max-w-4xl mx-auto">
                <h1 class="text-5xl md:text-7xl font-bold mb-6">
                    Suas Chaves Digitais<br/>
                    <span class="text-primary">Instantaneamente</span>
                </h1>
                <p class="text-xl text-gray-300 mb-8">Compre jogos com os melhores preços do mercado. Entrega imediata, segura e confiável.</p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button class="bg-primary hover:bg-red-700 px-8 py-4 rounded-lg font-bold text-lg transition transform hover:scale-105">Ver Ofertas</button>
                    <button class="bg-zinc-800 hover:bg-zinc-700 px-8 py-4 rounded-lg font-bold text-lg transition transform hover:scale-105">Explorar Catálogo</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Games -->
    <section class="py-16 bg-zinc-900">
        <div class="container mx-auto px-6">
            <div class="flex justify-between items-center mb-10">
                <h2 class="text-4xl font-bold">Jogos em <span class="text-primary">Destaque</span></h2>
                <a href="#" class="text-secondary hover:text-primary transition">Ver todos →</a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Game Card 1 -->
                <div class="bg-zinc-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition cursor-pointer group">
                    <div class="h-48 bg-gradient-to-br from-purple-600 to-blue-600 relative">
                        <div class="absolute top-4 right-4 bg-primary px-3 py-1 rounded-full text-sm font-bold">-25%</div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2 group-hover:text-primary transition">Cyberpunk Adventure</h3>
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-gray-400 line-through text-sm">R$ 199,90</span>
                                <p class="text-2xl font-bold text-primary">R$ 149,90</p>
                            </div>
                            <button class="bg-primary hover:bg-red-700 px-4 py-2 rounded-lg font-semibold transition">Comprar</button>
                        </div>
                    </div>
                </div>
                
                <!-- Game Card 2 -->
                <div class="bg-zinc-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition cursor-pointer group">
                    <div class="h-48 bg-gradient-to-br from-green-600 to-teal-600 relative">
                        <div class="absolute top-4 right-4 bg-secondary px-3 py-1 rounded-full text-sm font-bold">-50%</div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2 group-hover:text-primary transition">Fantasy Realm</h3>
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-gray-400 line-through text-sm">R$ 159,90</span>
                                <p class="text-2xl font-bold text-primary">R$ 79,90</p>
                            </div>
                            <button class="bg-primary hover:bg-red-700 px-4 py-2 rounded-lg font-semibold transition">Comprar</button>
                        </div>
                    </div>
                </div>
                
                <!-- Game Card 3 -->
                <div class="bg-zinc-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition cursor-pointer group">
                    <div class="h-48 bg-gradient-to-br from-red-600 to-orange-600 relative">
                        <div class="absolute top-4 right-4 bg-primary px-3 py-1 rounded-full text-sm font-bold">-15%</div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2 group-hover:text-primary transition">Racing Legends</h3>
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-gray-400 line-through text-sm">R$ 249,90</span>
                                <p class="text-2xl font-bold text-primary">R$ 212,90</p>
                            </div>
                            <button class="bg-primary hover:bg-red-700 px-4 py-2 rounded-lg font-semibold transition">Comprar</button>
                        </div>
                    </div>
                </div>
                
                <!-- Game Card 4 -->
                <div class="bg-zinc-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition cursor-pointer group">
                    <div class="h-48 bg-gradient-to-br from-yellow-600 to-red-600 relative">
                        <div class="absolute top-4 right-4 bg-secondary px-3 py-1 rounded-full text-sm font-bold">-40%</div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2 group-hover:text-primary transition">Space Odyssey</h3>
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-gray-400 line-through text-sm">R$ 129,90</span>
                                <p class="text-2xl font-bold text-primary">R$ 77,90</p>
                            </div>
                            <button class="bg-primary hover:bg-red-700 px-4 py-2 rounded-lg font-semibold transition">Comprar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="py-16 bg-zinc-950">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center p-6">
                    <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Entrega Instantânea</h3>
                    <p class="text-gray-400">Receba sua chave digital imediatamente após a compra</p>
                </div>
                <div class="text-center p-6">
                    <div class="w-16 h-16 bg-secondary rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">100% Seguro</h3>
                    <p class="text-gray-400">Todas as chaves são verificadas e originais</p>
                </div>
                <div class="text-center p-6">
                    <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Melhores Preços</h3>
                    <p class="text-gray-400">Ofertas exclusivas e preços imbatíveis</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-zinc-950 py-12 border-t border-zinc-800">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <div class="flex items-center space-x-2 mb-4">
                        <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center font-bold text-xl">DS</div>
                        <span class="text-xl font-bold">Digital<span class="text-primary">Spawn</span></span>
                    </div>
                    <p class="text-gray-400">Sua loja de confiança para chaves digitais de jogos.</p>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Loja</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-primary transition">Todos os Jogos</a></li>
                        <li><a href="#" class="hover:text-primary transition">Ofertas</a></li>
                        <li><a href="#" class="hover:text-primary transition">Lançamentos</a></li>
                        <li><a href="#" class="hover:text-primary transition">Mais Vendidos</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Suporte</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-primary transition">FAQ</a></li>
                        <li><a href="#" class="hover:text-primary transition">Contato</a></li>
                        <li><a href="#" class="hover:text-primary transition">Política de Reembolso</a></li>
                        <li><a href="#" class="hover:text-primary transition">Termos de Uso</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Newsletter</h4>
                    <p class="text-gray-400 mb-4">Receba ofertas exclusivas</p>
                    <div class="flex">
                        <input type="email" placeholder="Seu e-mail" class="bg-zinc-800 px-4 py-2 rounded-l-lg flex-1 focus:outline-none focus:ring-2 focus:ring-primary">
                        <button class="bg-primary hover:bg-red-700 px-4 py-2 rounded-r-lg transition">OK</button>
                    </div>
                </div>
            </div>
            <div class="border-t border-zinc-800 pt-8 text-center text-gray-400">
                <p>&copy; 2026 DigitalSpawn. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>
</body>
</html>
{% endblock %}