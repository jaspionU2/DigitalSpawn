<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - DigitalSpawn</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#ce7e00',
                        secondary: '#ca0505',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-zinc-900 text-white">
    <!-- Header -->
    <header class="bg-black border-b border-zinc-800">
        <nav class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <a href="index.html" class="text-2xl font-bold">
                    <span class="text-primary">Digital</span><span class="text-secondary">Spawn</span>
                </a>
                <div class="flex items-center space-x-4">
                    <span class="text-zinc-400">Já tem uma conta?</span>
                    <a href="login.html" class="text-primary hover:text-opacity-80 transition font-semibold">
                        Entrar
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Signup Section -->
    <section class="py-12 min-h-screen">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <!-- Header -->
                <div class="text-center mb-10">
                    <h1 class="text-4xl font-bold mb-4">
                        Crie sua <span class="text-primary">conta</span>
                    </h1>
                    <p class="text-zinc-400 text-lg">
                        Cadastre-se agora e ganhe 10% de desconto na primeira compra!
                    </p>
                </div>

                <!-- Signup Card -->
                <div class="bg-zinc-800 rounded-2xl border border-zinc-700 overflow-hidden">
                    <!-- Progress Steps -->
                    <div class="bg-black p-6 border-b border-zinc-700">
                        <div class="flex items-center justify-between max-w-md mx-auto">
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center font-bold text-black">
                                    1
                                </div>
                                <span class="text-xs mt-2 text-primary">Dados Pessoais</span>
                            </div>
                            <div class="flex-1 h-1 bg-zinc-700 mx-4"></div>
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 bg-zinc-700 rounded-full flex items-center justify-center font-bold">
                                    2
                                </div>
                                <span class="text-xs mt-2 text-zinc-400">Segurança</span>
                            </div>
                            <div class="flex-1 h-1 bg-zinc-700 mx-4"></div>
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 bg-zinc-700 rounded-full flex items-center justify-center font-bold">
                                    3
                                </div>
                                <span class="text-xs mt-2 text-zinc-400">Concluir</span>
                            </div>
                        </div>
                    </div>

                    <!-- Form -->
                    <div class="p-8 md:p-12">
                        <form action="/register" method="post" class="space-y-6">
                            <!-- Nome Completo -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold mb-2">Nome</label>
                                    <input 
                                        name="nome"
                                        type="text" 
                                        placeholder="Seu nome"
                                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                    >
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold mb-2">Sobrenome</label>
                                    <input 
                                        name="sobrenome"
                                        type="text" 
                                        placeholder="Seu sobrenome"
                                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                    >
                                </div>
                            </div>

                            <!-- Email -->
                            <div>
                                <label class="block text-sm font-semibold mb-2">E-mail</label>
                                <input 
                                    name="email"
                                    type="email" 
                                    placeholder="seu@email.com"
                                    class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                >
                            </div>

                            {# <!-- CPF e Data de Nascimento -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold mb-2">CPF</label>
                                    <input 
                                        type="text" 
                                        placeholder="000.000.000-00"
                                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                    >
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold mb-2">Data de Nascimento</label>
                                    <input 
                                        type="date" 
                                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                    >
                                </div>
                            </div> #}

                            <!-- Senha -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-semibold mb-2">Senha</label>
                                    <input 
                                        name="password"
                                        type="password" 
                                        placeholder="••••••••"
                                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                    >
                                    <p class="text-xs text-zinc-500 mt-2">Mínimo de 8 caracteres</p>
                                </div>
                                {# <div>
                                    <label class="block text-sm font-semibold mb-2">Confirmar Senha</label>
                                    <input 
                                        type="password" 
                                        placeholder="••••••••"
                                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                    >
                                </div> #}
                            </div>

                            <!-- Telefone -->
                            <div>
                                <label class="block text-sm font-semibold mb-2">Telefone (opcional)</label>
                                <input 
                                    name="telefone"
                                    type="tel" 
                                    placeholder="(00) 00000-0000"
                                    class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 focus:outline-none focus:border-primary transition"
                                >
                            </div>

                            <!-- Newsletter e Termos -->
                            <div class="space-y-4 pt-4">
                                <label class="flex items-start cursor-pointer group">
                                    <input 
                                        name="newsletter"
                                        type="checkbox" 
                                        class="mt-1 w-5 h-5 accent-primary"
                                    >
                                    <span class="ml-3 text-sm text-zinc-300 group-hover:text-white transition">
                                        Quero receber ofertas exclusivas e novidades por e-mail
                                    </span>
                                </label>
                                <label class="flex items-start cursor-pointer group">
                                    <input 
                                        name="termos"
                                        type="checkbox" 
                                        class="mt-1 w-5 h-5 accent-primary"
                                    >
                                    <span class="ml-3 text-sm text-zinc-300 group-hover:text-white transition">
                                        Li e aceito os <a href="#" class="text-primary hover:underline">Termos de Uso</a> e a <a href="#" class="text-primary hover:underline">Política de Privacidade</a>
                                    </span>
                                </label>
                            </div>

                            <!-- Botão de Cadastro -->
                            <button 
                                type="submit"
                                class="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 text-white font-bold py-4 rounded-lg transition text-lg mt-8"
                            >
                                Criar Minha Conta
                            </button>

                            <!-- Divider -->
                            <div class="relative my-8">
                                <div class="absolute inset-0 flex items-center">
                                    <div class="w-full border-t border-zinc-700"></div>
                                </div>
                                <div class="relative flex justify-center text-sm">
                                    <span class="px-4 bg-zinc-800 text-zinc-400">ou continue com</span>
                                </div>
                            </div>

                            <!-- Social Login -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <button 
                                    type="button"
                                    class="bg-zinc-900 border border-zinc-700 hover:border-primary rounded-lg py-3 transition flex items-center justify-center space-x-2"
                                >
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                                    </svg>
                                    <span>Google</span>
                                </button>
                                <button 
                                    type="button"
                                    class="bg-zinc-900 border border-zinc-700 hover:border-primary rounded-lg py-3 transition flex items-center justify-center space-x-2"
                                >
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                    </svg>
                                    <span>Facebook</span>
                                </button>
                                <button 
                                    type="button"
                                    class="bg-zinc-900 border border-zinc-700 hover:border-primary rounded-lg py-3 transition flex items-center justify-center space-x-2"
                                >
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/>
                                    </svg>
                                    <span>Apple</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Benefícios do Cadastro -->
                <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="text-center">
                        <div class="text-4xl mb-3">🎁</div>
                        <h3 class="font-bold mb-2">10% de Desconto</h3>
                        <p class="text-sm text-zinc-400">Na primeira compra para novos usuários</p>
                    </div>
                    <div class="text-center">
                        <div class="text-4xl mb-3">⚡</div>
                        <h3 class="font-bold mb-2">Acesso Instantâneo</h3>
                        <p class="text-sm text-zinc-400">Comece a comprar imediatamente</p>
                    </div>
                    <div class="text-center">
                        <div class="text-4xl mb-3">🔔</div>
                        <h3 class="font-bold mb-2">Ofertas Exclusivas</h3>
                        <p class="text-sm text-zinc-400">Receba promoções antes de todos</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black py-8 border-t border-zinc-800">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center justify-between">
                <div class="text-zinc-400 text-sm mb-4 md:mb-0">
                    &copy; 2026 DigitalSpawn. Todos os direitos reservados.
                </div>
                <div class="flex space-x-6 text-sm text-zinc-400">
                    <a href="#" class="hover:text-primary transition">Termos de Uso</a>
                    <a href="#" class="hover:text-primary transition">Privacidade</a>
                    <a href="#" class="hover:text-primary transition">Ajuda</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>